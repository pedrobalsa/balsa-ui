{
  "schemaVersion": 1,
  "name": "link",
  "title": "Link",
  "category": "component",
  "classification": "balsa-addition",
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Navigate to another location with consistent Balsa styling and safe external-link behavior.",
  "useFor": [
    "Page navigation",
    "Documentation links",
    "Call-to-action navigation"
  ],
  "avoidFor": [
    "Actions that do not change location",
    "Disabled navigation",
    "Icon-only links without an accessible name"
  ],
  "variants": [
    "text",
    "solid",
    "outline"
  ],
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "states": [
    "internal",
    "external"
  ],
  "accessibility": [
    "Uses native anchor semantics.",
    "External links receive a new browsing context and noreferrer protection.",
    "Icon-only usage requires the label prop."
  ],
  "tokens": [
    "--balsa-color-accent",
    "--balsa-color-accent-hover",
    "--balsa-color-primary",
    "--balsa-color-focus-ring",
    "radius.control"
  ],
  "commonMistakes": [
    "Using Link for an in-place action.",
    "Omitting a useful accessible name from an icon-only link.",
    "Manually duplicating button-like link styles.",
    "Adding a theme-specific glass variant instead of allowing outline to inherit the Glassmorphism material recipe."
  ],
  "examples": [
    "Text link",
    "Solid call to action",
    "External link with suffix icon"
  ],
  "publicApi": {
    "source": "src/components/ui/Link.vue",
    "props": [
      {
        "name": "href",
        "type": "string",
        "required": true
      },
      {
        "name": "variant",
        "type": "LinkVariant | undefined",
        "values": [
          "solid",
          "outline",
          "text"
        ],
        "required": false
      },
      {
        "name": "color",
        "type": "ActionColor | undefined",
        "values": [
          "primary",
          "neutral",
          "secondary",
          "accent",
          "destructive"
        ],
        "required": false,
        "default": "\"accent\""
      },
      {
        "name": "size",
        "type": "LinkSize | undefined",
        "values": [
          "md",
          "sm",
          "lg"
        ],
        "required": false
      },
      {
        "name": "prefixIcon",
        "type": "LucideIcon | undefined",
        "required": false
      },
      {
        "name": "suffixIcon",
        "type": "LucideIcon | undefined",
        "required": false
      },
      {
        "name": "external",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "label",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false
      },
      {
        "name": "rounded",
        "type": "Rounded | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "xl",
          "2xl",
          "none",
          "3xl",
          "full"
        ],
        "required": false
      },
      {
        "name": "shadow",
        "type": "ThemeShadow | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "auto",
          "none"
        ],
        "required": false
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      }
    ],
    "events": [],
    "slots": [
      {
        "name": "default",
        "type": "{}"
      }
    ]
  },
  "composition": {
    "neutralColor": "Neutral is the chrome color: a filled neutral action uses the inverse pair and every quieter treatment resolves to the plain foreground, so toolbar and shell controls do not compete with the content they frame."
  }
}
