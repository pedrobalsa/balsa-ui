{
  "schemaVersion": 1,
  "name": "collapsible",
  "title": "Collapsible",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "collapsible"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Reveal or hide one supporting content region without leaving the current context, using an underline disclosure by default.",
  "useFor": [
    "Optional details",
    "Progressive disclosure",
    "Compact supporting content"
  ],
  "avoidFor": [
    "Several coordinated panels",
    "Primary page navigation",
    "Content that must always be compared"
  ],
  "states": [
    "open",
    "closed",
    "disabled"
  ],
  "accessibility": [
    "Uses a native button with aria-expanded and aria-controls.",
    "The content region is labelled by its trigger.",
    "Closed retained content is inert and hidden from assistive technology."
  ],
  "variants": [
    "underline",
    "surface",
    "outline",
    "soft",
    "glass"
  ],
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "tokens": [
    "--balsa-color-surface",
    "--balsa-color-muted",
    "--balsa-color-muted-foreground",
    "--balsa-color-focus-ring",
    "radius.surface",
    "shadow.control"
  ],
  "commonMistakes": [
    "Using Collapsible for a multi-item accordion.",
    "Omitting a stable id or meaningful visible title.",
    "Placing required task content only inside the closed region."
  ],
  "examples": [
    "Open details",
    "Disabled disclosure",
    "Custom trigger slot"
  ],
  "publicApi": {
    "source": "src/components/ui/Collapsible.vue",
    "models": [
      {
        "name": "modelValue",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "event": "update:modelValue"
      }
    ],
    "props": [
      {
        "name": "id",
        "type": "string",
        "required": true
      },
      {
        "name": "title",
        "type": "string",
        "required": true
      },
      {
        "name": "variant",
        "type": "CollapsibleVariant | undefined",
        "values": [
          "soft",
          "outline",
          "glass",
          "surface",
          "underline"
        ],
        "required": false
      },
      {
        "name": "size",
        "type": "CollapsibleSize | undefined",
        "values": [
          "md",
          "sm",
          "lg"
        ],
        "required": false
      },
      {
        "name": "rounded",
        "type": "Rounded | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "xl",
          "2xl",
          "none",
          "3xl",
          "full"
        ],
        "required": false
      },
      {
        "name": "shadow",
        "type": "ThemeShadow | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "auto",
          "none"
        ],
        "required": false
      },
      {
        "name": "headingLevel",
        "type": "CollapsibleHeadingLevel | undefined",
        "values": [
          "2",
          "3",
          "4",
          "5",
          "6"
        ],
        "required": false,
        "default": "3"
      },
      {
        "name": "disabled",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      },
      {
        "name": "modelValue",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      }
    ],
    "events": [
      {
        "name": "update:modelValue",
        "type": "[value: boolean]"
      }
    ],
    "slots": [
      {
        "name": "trigger",
        "type": "{ open: boolean; }"
      },
      {
        "name": "default",
        "type": "{}"
      }
    ]
  }
}
