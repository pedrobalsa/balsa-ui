{
  "schemaVersion": 1,
  "name": "radio-group",
  "title": "Radio Group",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "radio-group"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Choose exactly one value from a visible, labelled set of mutually exclusive options with semantic selected color treatment.",
  "useFor": [
    "Short mutually exclusive choices",
    "Plans or delivery methods",
    "Settings with descriptions"
  ],
  "avoidFor": [
    "Zero-or-more choices",
    "Immediate binary settings",
    "Long searchable option collections"
  ],
  "types": [
    "column",
    "row",
    "cards"
  ],
  "states": [
    "default",
    "disabled",
    "loading",
    "validated",
    "unvalidated",
    "required"
  ],
  "sizes": [
    "sm",
    "md"
  ],
  "accessibility": [
    "A native fieldset and legend name the group.",
    "Native radio inputs preserve Arrow-key selection and one Tab stop for the checked option.",
    "Hints and explicit errors are associated with every choice."
  ],
  "tokens": [
    "--balsa-color-input",
    "--balsa-color-input-border",
    "--balsa-color-primary",
    "--balsa-color-secondary",
    "--balsa-color-accent",
    "--balsa-color-success",
    "--balsa-color-warning",
    "--balsa-color-info",
    "--balsa-color-destructive",
    "--balsa-color-focus-ring",
    "radius.control"
  ],
  "commonMistakes": [
    "Using cards without a visible legend.",
    "Using radio choices when multiple values may be selected.",
    "Removing native focus behavior from visually customized indicators."
  ],
  "examples": [
    "Column choices",
    "Inline choices",
    "Descriptive cards",
    "Invalid required group"
  ],
  "publicApi": {
    "source": "src/components/ui/RadioGroup.vue",
    "models": [
      {
        "name": "modelValue",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "event": "update:modelValue"
      }
    ],
    "props": [
      {
        "name": "id",
        "type": "string",
        "required": true
      },
      {
        "name": "label",
        "type": "string",
        "required": true
      },
      {
        "name": "options",
        "type": "readonly RadioGroupOption[]",
        "required": true
      },
      {
        "name": "name",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false
      },
      {
        "name": "layout",
        "type": "RadioGroupLayout | undefined",
        "values": [
          "column",
          "row",
          "cards"
        ],
        "required": false,
        "default": "\"column\""
      },
      {
        "name": "color",
        "type": "SemanticColor | undefined",
        "values": [
          "primary",
          "secondary",
          "accent",
          "destructive",
          "success",
          "warning",
          "info"
        ],
        "required": false,
        "default": "\"primary\""
      },
      {
        "name": "size",
        "type": "FieldSize | undefined",
        "values": [
          "md",
          "sm"
        ],
        "required": false
      },
      {
        "name": "rounded",
        "type": "Rounded | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "xl",
          "2xl",
          "none",
          "3xl",
          "full"
        ],
        "required": false
      },
      {
        "name": "hint",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false
      },
      {
        "name": "disabled",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "loading",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "status",
        "type": "FieldStatus | undefined",
        "values": [
          "default",
          "validated",
          "unvalidated"
        ],
        "required": false,
        "default": "\"default\""
      },
      {
        "name": "statusMessage",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false
      },
      {
        "name": "required",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      },
      {
        "name": "modelValue",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"\""
      }
    ],
    "events": [
      {
        "name": "update:modelValue",
        "type": "[value: string]"
      }
    ],
    "slots": []
  }
}
