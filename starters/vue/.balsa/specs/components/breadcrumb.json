{
  "schemaVersion": 1,
  "name": "breadcrumb",
  "title": "Breadcrumb",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "breadcrumb"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Show the current location in a compact hierarchy while linking every applicable ancestor.",
  "useFor": [
    "Documentation hierarchies",
    "Nested application locations",
    "Contextual path navigation"
  ],
  "avoidFor": [
    "Primary navigation",
    "Long unstructured tags",
    "Several unrelated destinations"
  ],
  "variants": [
    "chevron separator",
    "slash separator",
    "dot separator"
  ],
  "states": [
    "linked ancestor",
    "current page",
    "external ancestor"
  ],
  "accessibility": [
    "Renders a labelled navigation landmark and ordered list.",
    "The resolved current item exposes aria-current=page.",
    "Separators are hidden from assistive technology."
  ],
  "tokens": [
    "--balsa-color-foreground",
    "--balsa-color-muted",
    "--balsa-color-muted-foreground",
    "--balsa-color-focus-ring",
    "radius.control"
  ],
  "commonMistakes": [
    "Making the current page an active link.",
    "Using Breadcrumb as a substitute for primary navigation.",
    "Adding visible separators to assistive-technology output."
  ],
  "examples": [
    "Documentation path",
    "Mixed linked and plain hierarchy",
    "Slash-separated location"
  ],
  "publicApi": {
    "source": "src/components/ui/Breadcrumb.vue",
    "props": [
      {
        "name": "items",
        "type": "readonly BreadcrumbItem[]",
        "required": true
      },
      {
        "name": "separator",
        "type": "BreadcrumbSeparator | undefined",
        "values": [
          "dot",
          "chevron",
          "slash"
        ],
        "required": false,
        "default": "\"chevron\""
      },
      {
        "name": "size",
        "type": "BreadcrumbSize | undefined",
        "values": [
          "md",
          "sm"
        ],
        "required": false
      },
      {
        "name": "ariaLabel",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Breadcrumb\""
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      }
    ],
    "events": [],
    "slots": []
  }
}
