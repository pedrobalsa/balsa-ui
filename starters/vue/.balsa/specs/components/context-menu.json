{
  "schemaVersion": 1,
  "name": "context-menu",
  "title": "Context Menu",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "context-menu"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Open typed actions at a pointer or keyboard context request on a target region, with collision-safe viewport or contained-target positioning, semantic color, and configurable panel geometry.",
  "useFor": [
    "Canvas actions",
    "Row actions",
    "Editor context operations"
  ],
  "avoidFor": [
    "Primary actions",
    "Hidden-only functionality",
    "Native text editing commands"
  ],
  "types": [
    "action",
    "checkbox",
    "radio",
    "submenu"
  ],
  "states": [
    "closed",
    "open",
    "disabled",
    "checked",
    "highlighted"
  ],
  "sizes": [],
  "accessibility": [
    "Pointer context requests open at their coordinates and clamp to the viewport or contained target.",
    "ContextMenu and Shift+F10 open against the focusable target.",
    "The shared menu engine provides roles, roving focus, typeahead, dismissal, and restoration."
  ],
  "tokens": [
    "--balsa-color-selected",
    "--balsa-color-selected-foreground",
    "--balsa-color-primary",
    "--balsa-color-secondary",
    "--balsa-color-accent",
    "--balsa-color-destructive",
    "--balsa-color-focus-ring",
    "radius.control",
    "shadow.panel"
  ],
  "commonMistakes": [
    "Making actions available only through context click.",
    "Overriding native text-field context menus.",
    "Failing to label the target region."
  ],
  "examples": [
    "Canvas region",
    "Data row",
    "Checkable context setting",
    "Keyboard open"
  ],
  "publicApi": {
    "source": "src/components/ui/ContextMenu.vue",
    "models": [
      {
        "name": "modelValue",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "event": "update:modelValue"
      }
    ],
    "props": [
      {
        "name": "id",
        "type": "string",
        "required": true
      },
      {
        "name": "label",
        "type": "string",
        "required": true
      },
      {
        "name": "items",
        "type": "readonly MenuItem[]",
        "required": true
      },
      {
        "name": "variant",
        "type": "MenuVariant | undefined",
        "values": [
          "soft",
          "outline",
          "glass",
          "surface"
        ],
        "required": false
      },
      {
        "name": "color",
        "type": "ActionColor | undefined",
        "values": [
          "primary",
          "neutral",
          "secondary",
          "accent",
          "destructive"
        ],
        "required": false,
        "default": "\"primary\""
      },
      {
        "name": "rounded",
        "type": "Rounded | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "xl",
          "2xl",
          "none",
          "3xl",
          "full"
        ],
        "required": false
      },
      {
        "name": "shadow",
        "type": "ThemeShadow | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "auto",
          "none"
        ],
        "required": false
      },
      {
        "name": "contained",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "disabled",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      },
      {
        "name": "modelValue",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      }
    ],
    "events": [
      {
        "name": "update:modelValue",
        "type": "[value: boolean]"
      },
      {
        "name": "select",
        "type": "[selection: MenuSelection]"
      }
    ],
    "slots": [
      {
        "name": "default",
        "type": "{}"
      }
    ]
  }
}
