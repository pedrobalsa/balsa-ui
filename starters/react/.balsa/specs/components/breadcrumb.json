{
  "schemaVersion": 1,
  "name": "breadcrumb",
  "title": "Breadcrumb",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "breadcrumb"
  },
  "status": "beta",
  "version": "0.1.1",
  "purpose": "Show the current location in a compact hierarchy while linking every applicable ancestor.",
  "useFor": [
    "Documentation hierarchies",
    "Nested application locations",
    "Contextual path navigation"
  ],
  "avoidFor": [
    "Primary navigation",
    "Long unstructured tags",
    "Several unrelated destinations"
  ],
  "variants": [
    "chevron separator",
    "slash separator",
    "dot separator"
  ],
  "states": [
    "linked ancestor",
    "current page",
    "external ancestor"
  ],
  "accessibility": [
    "Renders a labelled navigation landmark and ordered list.",
    "The resolved current item exposes aria-current=page.",
    "Separators are hidden from assistive technology.",
    "The navigate event exposes the original uncancelled MouseEvent so router integration can preserve modifier clicks and native fallback."
  ],
  "tokens": [
    "--balsa-color-foreground",
    "--balsa-color-muted",
    "--balsa-color-muted-foreground",
    "--balsa-color-focus-ring",
    "radius.control"
  ],
  "commonMistakes": [
    "Making the current page an active link.",
    "Using Breadcrumb as a substitute for primary navigation.",
    "Adding visible separators to assistive-technology output."
  ],
  "examples": [
    {
      "id": "slash",
      "title": "Slash path",
      "description": "Use a slash separator when the hierarchy should read like a compact path.",
      "source": "<script setup lang=\"ts\">\nimport Breadcrumb from \"@/components/ui/Breadcrumb.vue\";\nconst items = [\n  { label: \"Section placeholder 01\", href: \"#section-placeholder-01\" },\n  { label: \"Section placeholder 02\", href: \"#section-placeholder-02\" },\n  { label: \"Current placeholder\" },\n];\n</script>\n\n<template>\n  <Breadcrumb :items=\"items\" separator=\"slash\" size=\"md\" />\n</template>"
    },
    {
      "id": "dot",
      "title": "Dot path",
      "description": "Use a dot separator for a quiet compact location trail.",
      "source": "<script setup lang=\"ts\">\nimport Breadcrumb from \"@/components/ui/Breadcrumb.vue\";\nconst items = [\n  { label: \"Section placeholder 01\", href: \"#section-placeholder-01\" },\n  { label: \"Section placeholder 02\", href: \"#section-placeholder-02\" },\n  { label: \"Current placeholder\" },\n];\n</script>\n\n<template>\n  <Breadcrumb :items=\"items\" separator=\"dot\" />\n</template>"
    }
  ],
  "publicApi": {
    "source": "src/components/ui/Breadcrumb.vue",
    "props": [
      {
        "name": "items",
        "type": "readonly BreadcrumbItem[]",
        "shape": {
          "type": "readonly BreadcrumbItem[]",
          "items": {
            "type": "BreadcrumbItem",
            "fields": [
              {
                "name": "label",
                "type": "string",
                "required": true
              },
              {
                "name": "href",
                "type": "string | undefined",
                "required": false
              },
              {
                "name": "target",
                "type": "\"_blank\" | \"_self\" | \"_parent\" | \"_top\" | undefined",
                "required": false
              },
              {
                "name": "rel",
                "type": "string | undefined",
                "required": false
              },
              {
                "name": "current",
                "type": "boolean | undefined",
                "required": false
              }
            ]
          }
        },
        "required": true
      },
      {
        "name": "separator",
        "type": "BreadcrumbSeparator | undefined",
        "values": [
          "dot",
          "chevron",
          "slash"
        ],
        "required": false,
        "default": "\"chevron\""
      },
      {
        "name": "size",
        "type": "BreadcrumbSize | undefined",
        "values": [
          "md",
          "sm"
        ],
        "required": false
      },
      {
        "name": "ariaLabel",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Breadcrumb\""
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      }
    ],
    "events": [
      {
        "name": "navigate",
        "type": "[item: NavigationLink, event: MouseEvent]"
      }
    ],
    "slots": []
  }
}
