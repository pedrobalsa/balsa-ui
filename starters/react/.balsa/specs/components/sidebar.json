{
  "schemaVersion": 1,
  "name": "sidebar",
  "title": "Sidebar",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "sidebar"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Present grouped application navigation as a persistent desktop sidebar and modal mobile drawer.",
  "useFor": [
    "Application navigation",
    "Workspace sections",
    "Dense tool destinations"
  ],
  "avoidFor": [
    "Marketing-site primary navigation",
    "One or two destinations",
    "Content filters without navigation"
  ],
  "states": [
    "expanded",
    "rail",
    "offcanvas",
    "mobile drawer",
    "nested group expanded"
  ],
  "accessibility": [
    "Desktop navigation remains non-modal.",
    "Rail items retain accessible labels and title cues.",
    "Mobile mode composes Drawer focus, Escape, backdrop, and restoration behavior."
  ],
  "variants": [
    "surface",
    "outline",
    "soft",
    "glass"
  ],
  "sizes": [
    "consumer-defined expanded and rail width"
  ],
  "tokens": [
    "--balsa-color-surface",
    "--balsa-color-selected",
    "--balsa-color-selected-foreground",
    "--balsa-color-border",
    "radius.surface"
  ],
  "commonMistakes": [
    "Coupling the primitive to a router or analytics.",
    "Hiding labels without accessible names.",
    "Using badges as decorative metadata rather than concise navigation counts."
  ],
  "examples": [
    {
      "id": "expanded",
      "title": "Expanded workspace",
      "description": "Grouped destinations retain labels, icons, and concise counts.",
      "source": "<script setup lang=\"ts\">\nimport Sidebar from \"@/components/ui/Sidebar.vue\";\nimport { LayoutDashboard, ChartNoAxesColumn, Archive } from \"@lucide/vue\";\nimport { ref } from \"vue\";\nimport type { SidebarGroup } from \"@/components/ui/Sidebar.vue\";\n\nconst active = ref(\"overview\");\nconst collapsed = ref(false);\nconst groups: readonly SidebarGroup[] = [{\n  id: \"main\",\n  label: \"Workspace placeholder\",\n  items: [\n    { id: \"overview\", label: \"Overview placeholder\", icon: LayoutDashboard },\n    { id: \"reports\", label: \"Reports placeholder\", icon: ChartNoAxesColumn, badge: \"3\" },\n    { id: \"archive\", label: \"Archive placeholder\", icon: Archive },\n  ],\n}];\n</script>\n\n<template>\n  <Sidebar id=\"workspace-navigation-placeholder\" v-model=\"active\" v-model:collapsed=\"collapsed\" label=\"Workspace placeholder\" :groups=\"groups\" side=\"left\" variant=\"surface\" collapsible=\"rail\" />\n</template>"
    },
    {
      "id": "rail",
      "title": "Compact rail",
      "description": "Rail mode preserves accessible names and title cues.",
      "source": "<script setup lang=\"ts\">\nimport Sidebar from \"@/components/ui/Sidebar.vue\";\nimport { LayoutDashboard, ChartNoAxesColumn, Archive } from \"@lucide/vue\";\nimport { ref } from \"vue\";\nimport type { SidebarGroup } from \"@/components/ui/Sidebar.vue\";\n\nconst active = ref(\"overview\");\nconst collapsed = ref(true);\nconst groups: readonly SidebarGroup[] = [{\n  id: \"main\",\n  label: \"Workspace placeholder\",\n  items: [\n    { id: \"overview\", label: \"Overview placeholder\", icon: LayoutDashboard },\n    { id: \"reports\", label: \"Reports placeholder\", icon: ChartNoAxesColumn, badge: \"3\" },\n    { id: \"archive\", label: \"Archive placeholder\", icon: Archive },\n  ],\n}];\n</script>\n\n<template>\n  <Sidebar id=\"workspace-navigation-placeholder\" v-model=\"active\" v-model:collapsed=\"collapsed\" label=\"Workspace placeholder\" :groups=\"groups\" side=\"left\" variant=\"surface\" collapsible=\"rail\" />\n</template>"
    },
    {
      "id": "glass",
      "title": "Glass navigation",
      "description": "Glass material remains a local visual choice over the same navigation model.",
      "source": "<script setup lang=\"ts\">\nimport Sidebar from \"@/components/ui/Sidebar.vue\";\nimport { LayoutDashboard, ChartNoAxesColumn, Archive } from \"@lucide/vue\";\nimport { ref } from \"vue\";\nimport type { SidebarGroup } from \"@/components/ui/Sidebar.vue\";\n\nconst active = ref(\"overview\");\nconst collapsed = ref(false);\nconst groups: readonly SidebarGroup[] = [{\n  id: \"main\",\n  label: \"Workspace placeholder\",\n  items: [\n    { id: \"overview\", label: \"Overview placeholder\", icon: LayoutDashboard },\n    { id: \"reports\", label: \"Reports placeholder\", icon: ChartNoAxesColumn, badge: \"3\" },\n    { id: \"archive\", label: \"Archive placeholder\", icon: Archive },\n  ],\n}];\n</script>\n\n<template>\n  <Sidebar id=\"workspace-navigation-placeholder\" v-model=\"active\" v-model:collapsed=\"collapsed\" label=\"Workspace placeholder\" :groups=\"groups\" side=\"left\" variant=\"glass\" collapsible=\"rail\" rounded=\"2xl\" />\n</template>"
    }
  ],
