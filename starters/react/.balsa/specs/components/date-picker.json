{
  "schemaVersion": 1,
  "name": "date-picker",
  "title": "DatePicker",
  "category": "component",
  "classification": "balsa-addition",
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Choose a single date or range from a labelled field and collision-safe calendar popup.",
  "useFor": [
    "Form dates",
    "Date ranges",
    "Locale-formatted date fields"
  ],
  "avoidFor": [
    "Time selection",
    "Free-text parsing",
    "Timezone conversion"
  ],
  "states": [
    "empty",
    "selected",
    "range pending",
    "disabled",
    "unvalidated"
  ],
  "accessibility": [
    "The visible label names the popup trigger.",
    "Calendar supplies complete grid keyboard behavior.",
    "Popup supplies Escape, outside dismissal, focus entry, and restoration, including Glassmorphism backdrop blur."
  ],
  "variants": [
    "single",
    "range"
  ],
  "sizes": [
    "popup field"
  ],
  "tokens": [
    "--balsa-color-input",
    "--balsa-color-input-border",
    "--balsa-color-destructive",
    "--balsa-color-focus-ring"
  ],
  "commonMistakes": [
    "Parsing locale-ambiguous text.",
    "Omitting visible error feedback.",
    "Using DatePicker for time values."
  ],
  "examples": [
    {
      "id": "single",
      "title": "Single date field",
      "description": "A labelled field opens the complete Calendar interaction.",
      "source": "<script setup lang=\"ts\">\nimport DatePicker from \"@/components/ui/DatePicker.vue\";\nimport { ref } from \"vue\";\nimport type { CalendarModelValue } from \"@/components/ui/Calendar.vue\";\n\nconst date = ref<CalendarModelValue>(null);\n</script>\n\n<template>\n  <DatePicker id=\"due-date-placeholder\" v-model=\"date\" label=\"Due date placeholder\" mode=\"single\" locale=\"en-US\" />\n</template>"
    },
    {
      "id": "range",
      "title": "Date range field",
      "description": "The popup remains open until both range boundaries exist.",
      "source": "<script setup lang=\"ts\">\nimport DatePicker from \"@/components/ui/DatePicker.vue\";\nimport { ref } from \"vue\";\nimport type { CalendarModelValue } from \"@/components/ui/Calendar.vue\";\n\nconst date = ref<CalendarModelValue>(null);\n</script>\n\n<template>\n  <DatePicker id=\"due-date-placeholder\" v-model=\"date\" label=\"Due date placeholder\" mode=\"range\" locale=\"en-US\" />\n</template>"
    },
    {
      "id": "invalid",
      "title": "Invalid date field",
      "description": "Explicit feedback accompanies the destructive trigger state.",
      "source": "<script setup lang=\"ts\">\nimport DatePicker from \"@/components/ui/DatePicker.vue\";\nimport { ref } from \"vue\";\nimport type { CalendarModelValue } from \"@/components/ui/Calendar.vue\";\n\nconst date = ref<CalendarModelValue>(null);\n</script>\n\n<template>\n  <DatePicker id=\"due-date-placeholder\" v-model=\"date\" label=\"Due date placeholder\" mode=\"single\" locale=\"en-US\" required status=\"unvalidated\" />\n</template>"
    }
  ],
