{
  "schemaVersion": 1,
  "name": "hover-card",
  "title": "Hover Card",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "hover-card"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Preview supplementary content from pointer hover or keyboard focus without moving focus.",
  "useFor": [
    "Profile previews",
    "Link summaries",
    "Supplementary metadata"
  ],
  "avoidFor": [
    "Essential actions",
    "Touch-only disclosure",
    "Blocking content"
  ],
  "types": [
    "top",
    "right",
    "bottom",
    "left"
  ],
  "states": [
    "closed",
    "opening",
    "open",
    "closing",
    "disabled"
  ],
  "sizes": [],
  "accessibility": [
    "The focusable trigger references the open preview.",
    "Focus never moves into hover content.",
    "Cancellable delays keep the card open while the pointer crosses into it."
  ],
  "tokens": [
    "--balsa-color-surface-elevated",
    "--balsa-color-border-strong",
    "--balsa-color-focus-ring",
    "radius.control",
    "shadow.panel"
  ],
  "commonMistakes": [
    "Putting essential controls in hover-only content.",
    "Using zero close delay across a pointer gap.",
    "Inventing hover behavior on touch."
  ],
  "examples": [
    {
      "id": "summary",
      "title": "Summary preview",
      "description": "Hover or keyboard focus reveals supplementary copy.",
      "source": "<script setup lang=\"ts\">\nimport HoverCard from \"@/components/ui/HoverCard.vue\";\n</script>\n\n<template>\n  <HoverCard id=\"summary-preview\" label=\"Summary placeholder\" :open-delay=\"300\" :close-delay=\"180\">\n    <template #trigger>Hover placeholder</template>\n    <h3>Preview heading placeholder</h3>\n    <p class=\"mt-balsa-xs text-sm text-balsa-muted-foreground\">Lorem ipsum dolor sit amet.</p>\n  </HoverCard>\n</template>"
    },
    {
      "id": "quick",
      "title": "Quick preview",
      "description": "Shorter delays remain cancellable across the pointer gap.",
      "source": "<script setup lang=\"ts\">\nimport HoverCard from \"@/components/ui/HoverCard.vue\";\n</script>\n\n<template>\n  <HoverCard id=\"summary-preview\" label=\"Summary placeholder\" :open-delay=\"100\" :close-delay=\"100\">\n    <template #trigger>Hover placeholder</template>\n    <h3>Preview heading placeholder</h3>\n    <p class=\"mt-balsa-xs text-sm text-balsa-muted-foreground\">Lorem ipsum dolor sit amet.</p>\n  </HoverCard>\n</template>"
    },
    {
      "id": "top",
      "title": "Top placement",
      "description": "Preferred placement flips when viewport space is insufficient.",
      "source": "<script setup lang=\"ts\">\nimport HoverCard from \"@/components/ui/HoverCard.vue\";\n</script>\n\n<template>\n  <HoverCard id=\"summary-preview\" label=\"Summary placeholder\" side=\"top\" :open-delay=\"300\" :close-delay=\"180\">\n    <template #trigger>Hover placeholder</template>\n    <h3>Preview heading placeholder</h3>\n    <p class=\"mt-balsa-xs text-sm text-balsa-muted-foreground\">Lorem ipsum dolor sit amet.</p>\n  </HoverCard>\n</template>"
    },
    {
      "id": "glass",
      "title": "Glass preview",
      "description": "Glass material remains readable over the generated field.",
      "source": "<script setup lang=\"ts\">\nimport HoverCard from \"@/components/ui/HoverCard.vue\";\n</script>\n\n<template>\n  <HoverCard id=\"summary-preview\" label=\"Summary placeholder\" variant=\"glass\" :open-delay=\"300\" :close-delay=\"180\">\n    <template #trigger>Hover placeholder</template>\n    <h3>Preview heading placeholder</h3>\n    <p class=\"mt-balsa-xs text-sm text-balsa-muted-foreground\">Lorem ipsum dolor sit amet.</p>\n  </HoverCard>\n</template>"
    }
  ],
