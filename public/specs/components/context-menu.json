{
  "schemaVersion": 1,
  "name": "context-menu",
  "title": "Context Menu",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "context-menu"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Open typed actions at a pointer or keyboard context request on a target region, with collision-safe viewport or contained-target positioning, semantic color, and configurable panel geometry.",
  "useFor": [
    "Canvas actions",
    "Row actions",
    "Editor context operations"
  ],
  "avoidFor": [
    "Primary actions",
    "Hidden-only functionality",
    "Native text editing commands"
  ],
  "types": [
    "action",
    "checkbox",
    "radio",
    "submenu"
  ],
  "states": [
    "closed",
    "open",
    "disabled",
    "checked",
    "highlighted"
  ],
  "sizes": [],
  "accessibility": [
    "Pointer context requests open at their coordinates and clamp to the viewport or contained target.",
    "ContextMenu and Shift+F10 open against the focusable target.",
    "The shared menu engine provides roles, roving focus, typeahead, dismissal, and restoration."
  ],
  "tokens": [
    "--balsa-color-selected",
    "--balsa-color-selected-foreground",
    "--balsa-color-primary",
    "--balsa-color-secondary",
    "--balsa-color-accent",
    "--balsa-color-destructive",
    "--balsa-color-focus-ring",
    "radius.control",
    "shadow.panel"
  ],
  "commonMistakes": [
    "Making actions available only through context click.",
    "Overriding native text-field context menus.",
    "Failing to label the target region."
  ],
  "examples": [
    {
      "id": "pointer",
      "title": "Pointer request",
      "description": "Right-click opens at the requested coordinates.",
      "source": "<script setup lang=\"ts\">\nimport ContextMenu from \"@/components/ui/ContextMenu.vue\";\nimport type { MenuItem } from \"@/components/ui/menu\";\n\nconst items: readonly MenuItem[] = [\n  { id: \"edit\", label: \"Edit placeholder\" },\n  { id: \"visible\", label: \"Visible placeholder\", type: \"checkbox\", checked: true },\n  { id: \"separator\", type: \"separator\" },\n  { id: \"remove\", label: \"Remove placeholder\", destructive: true },\n];\n\nfunction handleSelect(item: unknown): void {\n  console.info(\"Selected\", item);\n}\n</script>\n\n<template>\n  <ContextMenu id=\"canvas-menu\" label=\"Canvas actions placeholder\" :items=\"items\" @select=\"handleSelect\">\n    <div class=\"grid min-h-48 place-items-center rounded-xl border border-dashed border-balsa-border-strong\">Right-click placeholder</div>\n  </ContextMenu>\n</template>"
    },
    {
      "id": "keyboard",
      "title": "Keyboard request",
      "description": "Shift+F10 and ContextMenu open against the target with an accent rim and softer corners.",
      "source": "<script setup lang=\"ts\">\nimport ContextMenu from \"@/components/ui/ContextMenu.vue\";\nimport type { MenuItem } from \"@/components/ui/menu\";\n\nconst items: readonly MenuItem[] = [\n  { id: \"edit\", label: \"Edit placeholder\" },\n  { id: \"visible\", label: \"Visible placeholder\", type: \"checkbox\", checked: true },\n  { id: \"separator\", type: \"separator\" },\n  { id: \"remove\", label: \"Remove placeholder\", destructive: true },\n];\n\nfunction handleSelect(item: unknown): void {\n  console.info(\"Selected\", item);\n}\n</script>\n\n<template>\n  <ContextMenu id=\"canvas-menu\" label=\"Canvas actions placeholder\" :items=\"items\" variant=\"outline\" color=\"accent\" rounded=\"2xl\" @select=\"handleSelect\">\n    <div class=\"grid min-h-48 place-items-center rounded-xl border border-dashed border-balsa-border-strong\">Right-click placeholder</div>\n  </ContextMenu>\n</template>"
    },
    {
      "id": "glass",
      "title": "Glass menu",
      "description": "Teleported material preserves theme and palette context.",
      "source": "<script setup lang=\"ts\">\nimport ContextMenu from \"@/components/ui/ContextMenu.vue\";\nimport type { MenuItem } from \"@/components/ui/menu\";\n\nconst items: readonly MenuItem[] = [\n  { id: \"edit\", label: \"Edit placeholder\" },\n  { id: \"visible\", label: \"Visible placeholder\", type: \"checkbox\", checked: true },\n  { id: \"separator\", type: \"separator\" },\n  { id: \"remove\", label: \"Remove placeholder\", destructive: true },\n];\n\nfunction handleSelect(item: unknown): void {\n  console.info(\"Selected\", item);\n}\n</script>\n\n<template>\n  <ContextMenu id=\"canvas-menu\" label=\"Canvas actions placeholder\" :items=\"items\" variant=\"glass\" @select=\"handleSelect\">\n    <div class=\"grid min-h-48 place-items-center rounded-xl border border-dashed border-balsa-border-strong\">Right-click placeholder</div>\n  </ContextMenu>\n</template>"
    },
    {
      "id": "disabled",
      "title": "Native fallback",
      "description": "Disabled mode leaves the browser context menu intact.",
      "source": "<script setup lang=\"ts\">\nimport ContextMenu from \"@/components/ui/ContextMenu.vue\";\nimport type { MenuItem } from \"@/components/ui/menu\";\n\nconst items: readonly MenuItem[] = [\n  { id: \"edit\", label: \"Edit placeholder\" },\n  { id: \"visible\", label: \"Visible placeholder\", type: \"checkbox\", checked: true },\n  { id: \"separator\", type: \"separator\" },\n  { id: \"remove\", label: \"Remove placeholder\", destructive: true },\n];\n\nfunction handleSelect(item: unknown): void {\n  console.info(\"Selected\", item);\n}\n</script>\n\n<template>\n  <ContextMenu id=\"canvas-menu\" label=\"Canvas actions placeholder\" :items=\"items\" disabled @select=\"handleSelect\">\n    <div class=\"grid min-h-48 place-items-center rounded-xl border border-dashed border-balsa-border-strong\">Right-click placeholder</div>\n  </ContextMenu>\n</template>"
    }
  ],
