{
  "schemaVersion": 1,
  "name": "drawer",
  "title": "Drawer",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "drawer"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Present modal, scrollable task content from a viewport edge with native dialog semantics.",
  "useFor": [
    "Mobile task panels",
    "Filters and settings",
    "Secondary workflows"
  ],
  "avoidFor": [
    "Tiny contextual content",
    "Non-modal persistent navigation",
    "Unbounded nested drawers"
  ],
  "types": [
    "left",
    "right",
    "top",
    "bottom"
  ],
  "states": [
    "closed",
    "open",
    "dragging",
    "disabled-dismissal"
  ],
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "accessibility": [
    "Native modal dialog makes background content inert.",
    "The title and optional description label the drawer.",
    "Focus enters, traps, and restores; Escape/backdrop obey the dismissible policy."
  ],
  "tokens": [
    "--balsa-color-overlay",
    "--balsa-color-surface-elevated",
    "--balsa-color-border-strong",
    "--balsa-color-focus-ring",
    "shadow.panel"
  ],
  "commonMistakes": [
    "Using Drawer when Popup is sufficient.",
    "Omitting a title.",
    "Putting the only close path behind a non-dismissible policy."
  ],
  "examples": [
    {
      "id": "bottom",
      "title": "Bottom task",
      "description": "A modal task surface enters from the lower edge.",
      "source": "<script setup lang=\"ts\">\nimport Drawer from \"@/components/ui/Drawer.vue\";\nimport { ref } from \"vue\";\nimport Button from \"@/components/ui/Button.vue\";\n\nconst open = ref(false);\n</script>\n\n<template>\n  <Button @click=\"open = true\">Open drawer placeholder</Button>\n  <Drawer id=\"task-drawer\" v-model=\"open\" title=\"Task placeholder\" description=\"Lorem ipsum dolor sit amet.\" :show-handle=\"false\">\n    <p>Drawer content placeholder.</p>\n    <template #footer=\"{ close }\"><Button variant=\"outline\" @click=\"close\">Close placeholder</Button></template>\n  </Drawer>\n</template>"
    },
    {
      "id": "right",
      "title": "Right filters",
      "description": "Side placement supports longer scrollable settings.",
      "source": "<script setup lang=\"ts\">\nimport Drawer from \"@/components/ui/Drawer.vue\";\nimport { ref } from \"vue\";\nimport Button from \"@/components/ui/Button.vue\";\n\nconst open = ref(false);\n</script>\n\n<template>\n  <Button @click=\"open = true\">Open drawer placeholder</Button>\n  <Drawer id=\"task-drawer\" v-model=\"open\" title=\"Task placeholder\" description=\"Lorem ipsum dolor sit amet.\" side=\"right\" :show-handle=\"false\">\n    <p>Drawer content placeholder.</p>\n    <template #footer=\"{ close }\"><Button variant=\"outline\" @click=\"close\">Close placeholder</Button></template>\n  </Drawer>\n</template>"
    },
    {
      "id": "large",
      "title": "Large drawer",
      "description": "The largest extent remains viewport-capped.",
      "source": "<script setup lang=\"ts\">\nimport Drawer from \"@/components/ui/Drawer.vue\";\nimport { ref } from \"vue\";\nimport Button from \"@/components/ui/Button.vue\";\n\nconst open = ref(false);\n</script>\n\n<template>\n  <Button @click=\"open = true\">Open drawer placeholder</Button>\n  <Drawer id=\"task-drawer\" v-model=\"open\" title=\"Task placeholder\" description=\"Lorem ipsum dolor sit amet.\" size=\"lg\" :show-handle=\"false\">\n    <p>Drawer content placeholder.</p>\n    <template #footer=\"{ close }\"><Button variant=\"outline\" @click=\"close\">Close placeholder</Button></template>\n  </Drawer>\n</template>"
    },
    {
      "id": "fixed",
      "title": "Fixed decision",
      "description": "A non-dismissible panel keeps its explicit close workflow.",
      "source": "<script setup lang=\"ts\">\nimport Drawer from \"@/components/ui/Drawer.vue\";\nimport { ref } from \"vue\";\nimport Button from \"@/components/ui/Button.vue\";\n\nconst open = ref(false);\n</script>\n\n<template>\n  <Button @click=\"open = true\">Open drawer placeholder</Button>\n  <Drawer id=\"task-drawer\" v-model=\"open\" title=\"Task placeholder\" description=\"Lorem ipsum dolor sit amet.\" :dismissible=\"false\" :show-handle=\"false\">\n    <p>Drawer content placeholder.</p>\n    <template #footer=\"{ close }\"><Button variant=\"outline\" @click=\"close\">Close placeholder</Button></template>\n  </Drawer>\n</template>"
    }
  ],
