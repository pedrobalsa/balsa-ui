{
  "schemaVersion": 1,
  "name": "toast",
  "title": "Toast",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "sonner"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Present transient, non-blocking notifications in a viewport-level managed stack.",
  "useFor": [
    "Background-operation feedback",
    "Saved or completed confirmations",
    "Recoverable errors with a concise action"
  ],
  "avoidFor": [
    "Information required to complete a form",
    "Consequential confirmation decisions",
    "Persistent page-level guidance"
  ],
  "variants": [
    "surface",
    "soft",
    "outline",
    "glass"
  ],
  "types": [
    "top-start",
    "top-center",
    "top-end",
    "bottom-start",
    "bottom-center",
    "bottom-end"
  ],
  "states": [
    "timed",
    "sticky",
    "paused",
    "dismissed"
  ],
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "accessibility": [
    "Non-destructive items use polite status semantics while destructive items use assertive alert semantics.",
    "The viewport never moves focus and Escape dismisses the newest dismissible toast.",
    "Timers pause for hover, focus, window blur, and hidden documents so actions remain reachable."
  ],
  "tokens": [
    "--balsa-color-surface-elevated",
    "--balsa-color-primary",
    "--balsa-color-info",
    "--balsa-color-success",
    "--balsa-color-warning",
    "--balsa-color-destructive",
    "radius.surface",
    "shadow.surface",
    "motion.duration"
  ],
  "commonMistakes": [
    "Using Toast for feedback a user must retain.",
    "Adding several unrelated actions to one toast.",
    "Using a short duration for long descriptions or keyboard actions."
  ],
  "examples": [
    "Success notification",
    "Actionable information",
    "Sticky destructive feedback",
    "Top-center notification"
  ],
  "publicApi": {
    "source": "src/components/ui/ToastViewport.vue",
    "models": [
      {
        "name": "modelValue",
        "type": "readonly ToastItem[] | undefined",
        "event": "update:modelValue"
      }
    ],
    "props": [
      {
        "name": "label",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Notifications\""
      },
      {
        "name": "position",
        "type": "ToastPosition | undefined",
        "values": [
          "bottom-start",
          "bottom-end",
          "bottom-center",
          "top-start",
          "top-center",
          "top-end"
        ],
        "required": false,
        "default": "\"bottom-end\""
      },
      {
        "name": "limit",
        "type": "number | undefined",
        "values": [
          "number"
        ],
        "required": false,
        "default": "5"
      },
      {
        "name": "duration",
        "type": "number | undefined",
        "values": [
          "number"
        ],
        "required": false,
        "default": "5000"
      },
      {
        "name": "pauseOnHover",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "true"
      },
      {
        "name": "pauseOnFocus",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "true"
      },
      {
        "name": "contained",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "teleportTo",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"body\""
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      },
      {
        "name": "modelValue",
        "type": "readonly ToastItem[] | undefined",
        "required": false,
        "default": "[]"
      }
    ],
    "events": [
      {
        "name": "update:modelValue",
        "type": "[value: readonly ToastItem[]]"
      },
      {
        "name": "dismiss",
        "type": "[item: ToastItem, reason: ToastDismissReason]"
      },
      {
        "name": "action",
        "type": "[item: ToastItem]"
      }
    ],
    "slots": [
      {
        "name": "action",
        "type": "{ item: ToastItem; dismiss: () => void; run: () => void; }"
      }
    ]
  }
}
