{
  "schemaVersion": 1,
  "name": "command-toolbar-card",
  "title": "CommandToolbarCard",
  "category": "composition",
  "classification": "balsa-composition",
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Stacked command launcher with consistently aligned icons, descriptions, shortcuts, and full-row actions.",
  "useFor": [
    "Production application interfaces",
    "Design Studio composition previews",
    "Reusable product workflows"
  ],
  "avoidFor": [
    "Decorative variant galleries",
    "Unrelated content forced into one surface",
    "Pinned geometry or elevation that bypasses the active theme"
  ],
  "variants": [
    "theme inherited"
  ],
  "sizes": [
    "responsive"
  ],
  "states": [
    "default",
    "interactive",
    "disabled where applicable"
  ],
  "composition": {
    "root": "ApplicationCard",
    "regions": [
      "header",
      "command list",
      "command row"
    ],
    "research": "https://vercel.com/design/guidelines"
  },
  "accessibility": [
    "Heading level follows the surrounding document hierarchy.",
    "Every command is a full-width native Button with visible focus and disabled behavior.",
    "The action collection uses list semantics instead of claiming unsupported toolbar keyboard behavior.",
    "Supporting text and status do not rely on color alone."
  ],
  "tokens": [
    "--balsa-color-surface",
    "--balsa-color-surface-foreground",
    "--balsa-color-muted",
    "--balsa-color-muted-foreground",
    "--balsa-color-border",
    "--balsa-radius-surface",
    "--balsa-border-width",
    "--balsa-border-opacity",
    "--balsa-shadow-surface",
    "--balsa-density-factor"
  ],
  "commonMistakes": [
    "Pinning radius, border, or shadow instead of inheriting the design context.",
    "Replacing the typed data contract with demo-only DOM.",
    "Adding a second principal card surface.",
    "Returning to unequal wrapping controls that misalign labels and shortcuts."
  ],
  "examples": [
    "Design Studio Grid",
    "Application dashboard"
  ],
  "publicApi": {
    "source": "src/components/compositions/CommandToolbarCard.vue",
    "props": [
      {
        "name": "headingLevel",
        "type": "2 | 3 | 4 | 5 | 6 | undefined",
        "values": [
          "2",
          "3",
          "4",
          "5",
          "6"
        ],
        "required": false
      },
      {
        "name": "shadow",
        "type": "ThemeShadow | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "auto",
          "none"
        ],
        "required": false
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      },
      {
        "name": "title",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Quick actions\""
      },
      {
        "name": "description",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Start common workspace tasks from one place.\""
      },
      {
        "name": "actions",
        "type": "readonly ToolbarAction[] | undefined",
        "required": false,
        "default": "[ { id: \"copy\", label: \"Copy selection\", description: \"Duplicate the active content.\", icon: Copy, shortcut: [\"Ctrl\", \"C\"] }, { id: \"share\", label: \"Share workspace\", description: \"Invite people to collaborate.\", icon: Share2, shortcut: [\"S\"] }, { id: \"refresh\", label: \"Refresh data\", description: \"Sync the latest workspace state.\", icon: RefreshCw, shortcut: [\"R\"] }, { id: \"add\", label: \"Create resource\", description: \"Start a new workspace item.\", icon: Plus, shortcut: [\"Ctrl\", \"K\"] }, ]"
      }
    ],
    "events": [
      {
        "name": "action",
        "type": "[id: string]"
      }
    ],
    "slots": []
  }
}
