{
  "schemaVersion": 1,
  "name": "modal",
  "title": "Modal",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "dialog"
  },
  "status": "beta",
  "version": "0.1.1",
  "purpose": "Temporarily focus attention on a short decision, task, or viewport simulation above the current page.",
  "useFor": [
    "Confirmations",
    "Short focused tasks",
    "Compact supporting details"
  ],
  "avoidFor": [
    "Primary page content",
    "Long multi-step flows",
    "Notifications that do not require interaction"
  ],
  "variants": [
    "surface",
    "solid",
    "outline",
    "soft",
    "glass"
  ],
  "types": [
    "dialog",
    "sheet",
    "fullscreen"
  ],
  "states": [
    "closed",
    "open"
  ],
  "composition": {
    "model": "boolean",
    "slots": [
      "default",
      "eyebrow",
      "footer"
    ]
  },
  "accessibility": [
    "A title is required and labels the dialog.",
    "Escape and backdrop click close the modal.",
    "Open full-page modals lock background scrolling while preserving wheel and touch scrolling inside the dialog.",
    "Keyboard focus is trapped while open and returns to the triggering element after close."
  ],
  "tokens": [
    "--balsa-color-overlay",
    "--balsa-color-background",
    "--balsa-color-surface",
    "--balsa-color-surface-elevated",
    "--balsa-color-surface-elevated-foreground",
    "--balsa-color-primary",
    "--balsa-color-primary-foreground",
    "--balsa-color-secondary",
    "--balsa-color-secondary-foreground",
    "--balsa-color-accent",
    "--balsa-color-accent-foreground",
    "--balsa-color-destructive",
    "--balsa-color-destructive-foreground",
    "--balsa-color-focus-ring",
    "radius.surface",
    "shadow.surface"
  ],
  "commonMistakes": [
    "Nesting a modal inside another modal.",
    "Using a modal for lengthy page content.",
    "Removing the visible close affordance."
  ],
  "examples": [
    {
      "id": "dialog",
      "title": "Dialog",
      "description": "Dialog presentation centers a short, focused task.",
      "source": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport Button from \"@/components/ui/Button.vue\";\nimport Modal from \"@/components/ui/Modal.vue\";\n\nconst open = ref(false);\n</script>\n\n<template>\n  <Button @click=\"open = true\">Open</Button>\n  <Modal id=\"placeholder-modal\" v-model=\"open\" title=\"Modal heading placeholder\" description=\"Description placeholder for the modal surface.\" presentation=\"dialog\" variant=\"surface\" close-label=\"Close placeholder\">\n    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>\n    <template #footer=\"{ close }\">\n      <Button variant=\"outline\" @click=\"close\">Secondary action</Button>\n      <Button @click=\"close\">Primary action</Button>\n    </template>\n  </Modal>\n</template>"
    },
    {
      "id": "sheet",
      "title": "Sheet",
      "description": "Sheet presentation provides more vertical room from the viewport edge.",
      "source": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport Button from \"@/components/ui/Button.vue\";\nimport Modal from \"@/components/ui/Modal.vue\";\n\nconst open = ref(false);\n</script>\n\n<template>\n  <Button @click=\"open = true\">Open</Button>\n  <Modal id=\"placeholder-modal\" v-model=\"open\" title=\"Modal heading placeholder\" description=\"Description placeholder for the modal surface.\" presentation=\"sheet\" variant=\"surface\" close-label=\"Close placeholder\">\n    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>\n    <template #footer=\"{ close }\">\n      <Button variant=\"outline\" @click=\"close\">Secondary action</Button>\n      <Button @click=\"close\">Primary action</Button>\n    </template>\n  </Modal>\n</template>"
    }
  ],
