{
  "schemaVersion": 1,
  "name": "alert",
  "title": "Alert",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "alert"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Communicate important inline feedback or present a focused alert-dialog decision.",
  "useFor": [
    "System and form feedback",
    "Warnings and success confirmation",
    "Focused consequential decisions"
  ],
  "avoidFor": [
    "Routine helper text",
    "Unrelated page chrome",
    "Transient feedback better served by Toast"
  ],
  "variants": [
    "surface",
    "outline",
    "soft",
    "solid",
    "glass"
  ],
  "types": [
    "inline",
    "dialog"
  ],
  "states": [
    "hidden",
    "visible",
    "dismissed"
  ],
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "accessibility": [
    "Inline mode uses alert semantics and does not move focus.",
    "Dialog mode uses native modal alertdialog semantics, labels, initial focus, Escape handling, and focus restoration.",
    "Persistent alerts disable every built-in dismissal path while retaining a clear task-specific action.",
    "Every icon is decorative because the visible title and description communicate status."
  ],
  "tokens": [
    "--balsa-color-surface",
    "--balsa-color-info",
    "--balsa-color-success",
    "--balsa-color-warning",
    "--balsa-color-destructive",
    "--balsa-color-overlay",
    "radius.surface",
    "shadow.surface",
    "motion.duration"
  ],
  "commonMistakes": [
    "Using dialog mode for passive information.",
    "Making a persistent dialog without a clear task-specific action.",
    "Using success or warning color without matching content meaning."
  ],
  "examples": [
    "Inline information",
    "Success feedback",
    "Dismissible warning",
    "Destructive alert dialog"
  ],
  "publicApi": {
    "source": "src/components/ui/Alert.vue",
    "models": [
      {
        "name": "modelValue",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "event": "update:modelValue"
      }
    ],
    "props": [
      {
        "name": "id",
        "type": "string",
        "required": true
      },
      {
        "name": "title",
        "type": "string",
        "required": true
      },
      {
        "name": "description",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false
      },
      {
        "name": "mode",
        "type": "AlertMode | undefined",
        "values": [
          "inline",
          "dialog"
        ],
        "required": false,
        "default": "\"inline\""
      },
      {
        "name": "color",
        "type": "AlertColor | undefined",
        "values": [
          "neutral",
          "destructive",
          "success",
          "warning",
          "info"
        ],
        "required": false,
        "default": "\"neutral\""
      },
      {
        "name": "variant",
        "type": "AlertVariant | undefined",
        "values": [
          "solid",
          "soft",
          "outline",
          "glass",
          "surface"
        ],
        "required": false
      },
      {
        "name": "size",
        "type": "AlertSize | undefined",
        "values": [
          "md",
          "sm",
          "lg"
        ],
        "required": false
      },
      {
        "name": "rounded",
        "type": "Rounded | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "xl",
          "2xl",
          "none",
          "3xl",
          "full"
        ],
        "required": false
      },
      {
        "name": "shadow",
        "type": "ThemeShadow | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "auto",
          "none"
        ],
        "required": false
      },
      {
        "name": "icon",
        "type": "LucideIcon | undefined",
        "required": false
      },
      {
        "name": "persistent",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "closeLabel",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Dismiss alert\""
      },
      {
        "name": "outsideDismiss",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "escapeDismiss",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "true"
      },
      {
        "name": "initialFocus",
        "type": "AlertInitialFocus | undefined",
        "values": [
          "close",
          "dialog",
          "action"
        ],
        "required": false,
        "default": "\"action\""
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      },
      {
        "name": "modelValue",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false
      }
    ],
    "events": [
      {
        "name": "update:modelValue",
        "type": "unknown[]"
      },
      {
        "name": "dismiss",
        "type": "[]"
      }
    ],
    "slots": [
      {
        "name": "default",
        "type": "{}"
      },
      {
        "name": "actions",
        "type": "{ close: () => void; }"
      }
    ]
  }
}
