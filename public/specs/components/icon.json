{
  "schemaVersion": 1,
  "name": "icon",
  "title": "Icon",
  "category": "component",
  "classification": "balsa-addition",
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Render one individually imported Lucide component through Balsa sizing, stroke, color inheritance, and accessibility semantics.",
  "useFor": [
    "Consistent interface symbols",
    "Component-valued icon APIs",
    "Named standalone symbols"
  ],
  "avoidFor": [
    "Dynamic string lookup",
    "Product logos",
    "Illustrations"
  ],
  "variants": [
    "decorative",
    "labelled"
  ],
  "sizes": [
    "xs",
    "sm",
    "md",
    "lg",
    "xl"
  ],
  "states": [
    "decorative",
    "accessible image"
  ],
  "accessibility": [
    "Decorative icons are aria-hidden and not focusable.",
    "A labelled icon uses role=img and aria-label.",
    "Icon-only interactive controls name the owning control; their icon normally remains decorative."
  ],
  "tokens": [
    "currentColor"
  ],
  "commonMistakes": [
    "Passing a string instead of a Lucide component.",
    "Loading the complete dynamic Lucide map.",
    "Labelling a decorative icon.",
    "Using Icon for product branding."
  ],
  "examples": [
    "Decorative search icon",
    "Labelled help image",
    "Icon-only button with an accessible control name"
  ],
  "publicApi": {
    "source": "src/components/ui/Icon.vue",
    "props": [
      {
        "name": "icon",
        "type": "LucideIcon",
        "required": true
      },
      {
        "name": "size",
        "type": "IconSize | undefined",
        "values": [
          "md",
          "xs",
          "sm",
          "lg",
          "xl"
        ],
        "required": false,
        "default": "\"md\""
      },
      {
        "name": "strokeWidth",
        "type": "IconStrokeWidth | undefined",
        "values": [
          "2",
          "1.5",
          "2.5"
        ],
        "required": false,
        "default": "2"
      },
      {
        "name": "label",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false
      }
    ],
    "events": [],
    "slots": []
  }
}
