      "content": "export interface BrandImage {\n  src: string;\n  alt: string;\n  href: string;\n  title?: never;\n}\n\nexport interface BrandTitle {\n  title: string;\n  alt: string;\n  href: string;\n  src?: never;\n}\n\nexport type BrandLogo = BrandImage | BrandTitle;\n\nexport interface NavigationLink {\n  title: string;\n  link: string;\n  shortDescription?: string;\n}\n\nexport interface NavigationGroup extends NavigationLink {\n  links?: readonly NavigationLink[];\n}\n\nexport interface FooterSection {\n  title: string;\n  links: readonly NavigationLink[];\n}\n\nexport interface FooterSocialLink {\n  title: string;\n  link: string;\n  icon: IconComponent;\n}\n\nexport interface FooterContactItem {\n  label: string;\n  link?: string;\n  detail?: string;\n  external?: boolean;\n}\n\nexport interface FooterContactGroup {\n  title: string;\n  items: readonly FooterContactItem[];\n}\nimport type { IconComponent } from \"./Icon.vue\";\n"
    }
