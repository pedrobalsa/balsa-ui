{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "storage-usage-card",
  "type": "registry:ui",
  "title": "StorageUsageCard",
  "description": "Half-height single measurement with the bar that puts it in context.",
  "dependencies": [
    "vue"
  ],
  "registryDependencies": [
    "@balsa/application-card",
    "@balsa/progress"
  ],
  "files": [
    {
      "path": "src/components/compositions/StorageUsageCard.vue",
      "type": "registry:ui",
      "target": "src/components/compositions/StorageUsageCard.vue",
      "content": "<script setup lang=\"ts\">\nimport Progress from \"../ui/Progress.vue\";\nimport CompositionRoot from \"./_CompositionRoot.vue\";\nimport type { CompositionSurfaceProps } from \"./composition\";\n\n/**\n * A single figure and the bar that puts it in context. Half a unit tall is the\n * honest size for one measurement: there is no second thing to say about it.\n */\nconst props = withDefaults(defineProps<CompositionSurfaceProps & {\n  title?: string;\n  description?: string;\n  used?: string;\n  included?: string;\n  percent?: number;\n}>(), {\n  title: \"Object storage\",\n  used: \"612 GB\",\n  included: \"of 1 TB included\",\n  percent: 61,\n});\n</script>\n\n<template>\n  <CompositionRoot v-bind=\"props\" data-composition=\"storage-usage\">\n    <p class=\"flex items-baseline gap-balsa-xs\">\n      <strong class=\"text-2xl font-semibold tabular-nums\">{{ props.used }}</strong>\n      <span class=\"text-xs text-balsa-muted-foreground\">{{ props.included }}</span>\n    </p>\n    <Progress class=\"mt-balsa-md\" label=\"Storage used\" :value=\"props.percent\" color=\"primary\" />\n  </CompositionRoot>\n</template>\n"
    }
  ],
  "meta": {
    "framework": "vue",
    "spec": "specs/components/storage-usage-card.json",
    "documentation": "docs/compositions/storage-usage-card.md",
    "example": "docs/compositions/storage-usage-card.md",
    "tokens": [
      "--balsa-color-surface",
      "--balsa-color-surface-foreground",
      "--balsa-color-muted",
      "--balsa-color-muted-foreground",
      "--balsa-color-border",
      "--balsa-radius-surface",
      "--balsa-border-width",
      "--balsa-border-opacity",
      "--balsa-shadow-surface",
      "--balsa-density-factor"
    ]
  }
}
