{
  "schemaVersion": 1,
  "name": "pagination",
  "title": "Pagination",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "pagination"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Move through a finite result set with bounded pages, labelled adjacent actions, or icon-only adjacent actions.",
  "useFor": [
    "Search results",
    "Tables",
    "Long server-backed collections"
  ],
  "avoidFor": [
    "Short collections",
    "Continuous feeds",
    "Progress through a form workflow"
  ],
  "states": [
    "first page",
    "middle page",
    "last page",
    "disabled"
  ],
  "accessibility": [
    "Uses a labelled nav landmark and native buttons.",
    "The active page exposes aria-current.",
    "Boundary actions use native disabled semantics and every icon-only control has an accessible label."
  ],
  "variants": [
    "bounded pages with semantic ellipses",
    "action labels only",
    "icons only"
  ],
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "tokens": [
    "--balsa-color-surface",
    "--balsa-color-primary",
    "--balsa-color-primary-foreground",
    "--balsa-color-focus-ring",
    "radius.control"
  ],
  "commonMistakes": [
    "Using zero-based public page numbers.",
    "Changing result density inside pagination without an explicit page-size control.",
    "Removing accessible names from icon-only controls."
  ],
  "examples": [
    {
      "id": "default",
      "title": "Bounded result pages",
      "description": "Sibling pages and semantic ellipses keep a large result set compact.",
      "source": "<script setup lang=\"ts\">\nimport Pagination from \"@/components/ui/Pagination.vue\";\nimport { ref } from \"vue\";\n\nconst page = ref(4);\n</script>\n\n<template>\n  <Pagination v-model=\"page\" :total=\"248\" :page-size=\"20\" :sibling-count=\"1\" label=\"Result pages placeholder\" />\n</template>"
    },
    {
      "id": "compact",
      "title": "Compact navigation",
      "description": "Small icon-forward controls fit dense result surfaces.",
      "source": "<script setup lang=\"ts\">\nimport Pagination from \"@/components/ui/Pagination.vue\";\nimport { ref } from \"vue\";\n\nconst page = ref(4);\n</script>\n\n<template>\n  <Pagination v-model=\"page\" :total=\"96\" :page-size=\"12\" :sibling-count=\"1\" label=\"Result pages placeholder\" presentation=\"icons\" size=\"sm\" />\n</template>"
    },
    {
      "id": "action-labels",
      "title": "Adjacent actions",
      "description": "Previous and next labels provide document-style navigation without a page range.",
      "source": "<script setup lang=\"ts\">\nimport Pagination from \"@/components/ui/Pagination.vue\";\nimport { ref } from \"vue\";\n\nconst page = ref(4);\n</script>\n\n<template>\n  <Pagination v-model=\"page\" :total=\"72\" :page-size=\"10\" :sibling-count=\"1\" label=\"Result pages placeholder\" presentation=\"action-labels\" />\n</template>"
    },
    {
      "id": "without-edges",
      "title": "Previous and next",
      "description": "Edge controls can be omitted while bounded page context remains.",
      "source": "<script setup lang=\"ts\">\nimport Pagination from \"@/components/ui/Pagination.vue\";\nimport { ref } from \"vue\";\n\nconst page = ref(4);\n</script>\n\n<template>\n  <Pagination v-model=\"page\" :total=\"72\" :page-size=\"10\" :sibling-count=\"1\" label=\"Result pages placeholder\" :show-edges=\"false\" />\n</template>"
    }
  ],
