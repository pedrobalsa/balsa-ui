{
  "schemaVersion": 1,
  "name": "attachment",
  "title": "Attachment",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "attachment"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Select and review local files through a labelled, validated native input.",
  "useFor": [
    "File selection",
    "Upload preparation",
    "Attachment lists"
  ],
  "avoidFor": [
    "Automatic network uploads",
    "Remote file browsing",
    "Decorative file metadata"
  ],
  "states": [
    "empty",
    "selected",
    "dragging",
    "loading",
    "disabled",
    "unvalidated"
  ],
  "accessibility": [
    "Uses a labelled native file input.",
    "Validation errors use explicit alert text.",
    "Every selected file has a named remove action."
  ],
  "variants": [
    "single",
    "multiple"
  ],
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "tokens": [
    "--balsa-color-input",
    "--balsa-color-input-border",
    "--balsa-color-destructive",
    "--balsa-color-focus-ring",
    "radius.control"
  ],
  "commonMistakes": [
    "Uploading automatically inside the primitive.",
    "Relying only on accept without validating selected files.",
    "Removing a file through an unnamed icon action."
  ],
  "examples": [
    {
      "id": "multiple",
      "title": "Multiple documents",
      "description": "Count, type, and size validation run before files enter the model.",
      "source": "<script setup lang=\"ts\">\nimport Attachment from \"@/components/ui/Attachment.vue\";\nimport { ref } from \"vue\";\n\nconst files = ref<readonly File[]>([]);\n</script>\n\n<template>\n  <Attachment id=\"files-placeholder\" v-model=\"files\" label=\"Files placeholder\" accept=\".pdf,.png,.jpg\" :max-size=\"5242880\" :max-files=\"4\" multiple />\n</template>"
    },
    {
      "id": "single",
      "title": "Single image",
      "description": "Single mode replaces the prior local selection.",
      "source": "<script setup lang=\"ts\">\nimport Attachment from \"@/components/ui/Attachment.vue\";\nimport { ref } from \"vue\";\n\nconst files = ref<readonly File[]>([]);\n</script>\n\n<template>\n  <Attachment id=\"files-placeholder\" v-model=\"files\" label=\"Files placeholder\" accept=\"image/*\" :max-size=\"5242880\" :max-files=\"4\" />\n</template>"
    },
    {
      "id": "invalid",
      "title": "Validation feedback",
      "description": "Explicit error copy accompanies the destructive field state.",
      "source": "<script setup lang=\"ts\">\nimport Attachment from \"@/components/ui/Attachment.vue\";\nimport { ref } from \"vue\";\n\nconst files = ref<readonly File[]>([]);\n</script>\n\n<template>\n  <Attachment id=\"files-placeholder\" v-model=\"files\" label=\"Files placeholder\" accept=\".pdf,.png,.jpg\" :max-size=\"5242880\" :max-files=\"4\" multiple status=\"unvalidated\" />\n</template>"
    }
  ],
