        "values": [
          "default",
          "compact",
          "comfortable"
        ],
        "required": false
      },
      {
        "name": "headerColor",
        "type": "TableColor | undefined",
        "values": [
          "primary",
          "neutral",
          "secondary",
          "accent",
          "destructive",
          "success",
          "warning",
          "info"
        ],
        "required": false,
        "default": "\"neutral\""
      },
      {
        "name": "rowColor",
        "type": "TableColor | undefined",
        "values": [
          "primary",
