{
  "schemaVersion": 1,
  "name": "usage-breakdown-card",
  "title": "UsageBreakdownCard",
  "category": "composition",
  "classification": "balsa-composition",
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Stacked bars attributing billed usage to categories over time.",
  "useFor": [
    "Production application interfaces",
    "Design Studio composition previews",
    "Reusable product workflows"
  ],
  "avoidFor": [
    "Decorative variant galleries",
    "Unrelated content forced into one surface",
    "Pinned geometry or elevation that bypasses the active theme"
  ],
  "variants": [
    "theme inherited"
  ],
  "sizes": [
    "responsive"
  ],
  "states": [
    "default",
    "interactive",
    "disabled where applicable"
  ],
  "composition": {
    "root": "ApplicationCard",
    "regions": [
      "header",
      "action",
      "body",
      "footer"
    ],
    "research": "https://docs.aws.amazon.com/cost-management/"
  },
  "accessibility": [
    "Heading level follows the surrounding document hierarchy.",
    "Interactive controls retain native keyboard and focus behavior through Balsa primitives.",
    "Supporting text and status do not rely on color alone."
  ],
  "tokens": [
    "--balsa-color-surface",
    "--balsa-color-surface-foreground",
    "--balsa-color-muted",
    "--balsa-color-muted-foreground",
    "--balsa-color-border",
    "--balsa-radius-surface",
    "--balsa-border-width",
    "--balsa-border-opacity",
    "--balsa-shadow-surface",
    "--balsa-density-factor"
  ],
  "commonMistakes": [
    "Pinning radius, border, or shadow instead of inheriting the design context.",
    "Replacing the typed data contract with demo-only DOM.",
    "Adding a second principal card surface."
  ],
  "publicApi": {
    "source": "src/components/compositions/UsageBreakdownCard.vue",
    "props": [
      {
        "name": "headingLevel",
        "type": "2 | 3 | 4 | 5 | 6 | undefined",
        "values": [
          "2",
          "3",
          "4",
          "5",
          "6"
        ],
        "required": false
      },
      {
        "name": "shadow",
        "type": "ThemeShadow | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "auto",
          "none"
        ],
        "required": false
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      },
      {
        "name": "title",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Where the spend goes\""
      },
      {
        "name": "description",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Billed usage by category, last twelve months.\""
      },
      {
        "name": "labels",
        "type": "readonly string[] | undefined",
        "required": false,
        "default": "[\"Sep\", \"Oct\", \"Nov\", \"Dec\", \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\"]"
      },
      {
        "name": "series",
        "type": "readonly UsageSeries[] | undefined",
        "shape": {
          "type": "readonly UsageSeries[]",
          "items": {
            "type": "UsageSeries",
            "fields": [
              {
                "name": "label",
                "type": "string",
                "required": true
              },
              {
                "name": "data",
                "type": "readonly number[]",
                "required": true
              },
              {
                "name": "color",
                "type": "CompositionPaletteColor | undefined",
                "required": false
              }
            ]
          }
        },
        "required": false,
        "default": "[ { label: \"Compute\", data: [96, 104, 112, 119, 108, 121, 128, 141, 137, 162, 158, 174], color: \"primary\" }, { label: \"Bandwidth\", data: [41, 46, 52, 63, 49, 58, 64, 71, 88, 74, 92, 96], color: \"secondary\" }, { label: \"Storage\", data: [14, 15, 17, 18, 19, 21, 22, 24, 27, 29, 31, 35], color: \"accent\" }, ]"
      }
    ],
    "events": [],
    "slots": []
  },
  "examples": [
    {
      "id": "default",
      "title": "Default pattern",
      "description": "Use the default typed pattern as a production-ready starting point.",
      "source": "<script setup lang=\"ts\">\nimport UsageBreakdownCard from \"@/components/compositions/UsageBreakdownCard.vue\";\n</script>\n\n<template>\n  <UsageBreakdownCard title=\"Pattern placeholder\" />\n</template>"
    },
    {
      "id": "inherited-design",
      "title": "Inherited design",
      "description": "The same composition follows the nearest Balsa theme and palette without pinned presentation.",
      "source": "<script setup lang=\"ts\">\nimport UsageBreakdownCard from \"@/components/compositions/UsageBreakdownCard.vue\";\n</script>\n\n<template>\n  <UsageBreakdownCard title=\"Pattern placeholder\" />\n</template>"
    }
  ]
}
