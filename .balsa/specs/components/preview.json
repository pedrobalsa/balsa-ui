        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "fullscreen",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "true"
      },
      {
        "name": "fullscreenLabel",
        "type": "string | undefined",
        "values": [
