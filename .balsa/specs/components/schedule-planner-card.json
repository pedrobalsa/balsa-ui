{
  "schemaVersion": 1,
  "name": "schedule-planner-card",
  "title": "SchedulePlannerCard",
  "category": "composition",
  "classification": "balsa-composition",
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Calendar paired with the bookable hours for the chosen day.",
  "useFor": [
    "Production application interfaces",
    "Design Studio composition previews",
    "Reusable product workflows"
  ],
  "avoidFor": [
    "Decorative variant galleries",
    "Unrelated content forced into one surface",
    "Pinned geometry or elevation that bypasses the active theme"
  ],
  "variants": [
    "theme inherited"
  ],
  "sizes": [
    "responsive"
  ],
  "states": [
    "default",
    "interactive",
    "disabled where applicable"
  ],
  "composition": {
    "root": "ApplicationCard",
    "regions": [
      "header",
      "action",
      "body",
      "footer"
    ],
    "research": "https://cal.com/docs"
  },
  "accessibility": [
    "Heading level follows the surrounding document hierarchy.",
    "Interactive controls retain native keyboard and focus behavior through Balsa primitives.",
    "Supporting text and status do not rely on color alone."
  ],
  "tokens": [
    "--balsa-color-surface",
    "--balsa-color-surface-foreground",
    "--balsa-color-muted",
    "--balsa-color-muted-foreground",
    "--balsa-color-border",
    "--balsa-radius-surface",
    "--balsa-border-width",
    "--balsa-border-opacity",
    "--balsa-shadow-surface",
    "--balsa-density-factor"
  ],
  "commonMistakes": [
    "Pinning radius, border, or shadow instead of inheriting the design context.",
    "Replacing the typed data contract with demo-only DOM.",
    "Adding a second principal card surface."
  ],
  "publicApi": {
    "source": "src/components/compositions/SchedulePlannerCard.vue",
    "props": [
      {
        "name": "headingLevel",
        "type": "2 | 3 | 4 | 5 | 6 | undefined",
        "values": [
          "2",
          "3",
          "4",
          "5",
          "6"
        ],
        "required": false
      },
      {
        "name": "shadow",
        "type": "ThemeShadow | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "auto",
          "none"
        ],
        "required": false
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      },
      {
        "name": "title",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Schedule meeting\""
      },
      {
        "name": "description",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Pick a day and an hour that suits you both.\""
      },
      {
        "name": "guestName",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Grace Hopper\""
      },
      {
        "name": "guestRole",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Platform, Frankfurt\""
      },
      {
        "name": "guestInitials",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"GH\""
      },
      {
        "name": "guestEmail",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"grace@example.com\""
      },
      {
        "name": "slots",
        "type": "readonly ScheduleSlot[] | undefined",
        "shape": {
          "type": "readonly ScheduleSlot[]",
          "items": {
            "type": "ScheduleSlot",
            "fields": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "time",
                "type": "string",
                "required": true
              },
              {
                "name": "label",
                "type": "string",
                "required": true
              },
              {
                "name": "taken",
                "type": "boolean | undefined",
                "required": false
              }
            ]
          }
        },
        "required": false,
        "default": "[ { id: \"08\", time: \"08:00\", label: \"Early, before either inbox\" }, { id: \"09\", time: \"09:00\", label: \"Before the standup\" }, { id: \"10\", time: \"10:00\", label: \"Held for the release review\", taken: true }, { id: \"11\", time: \"11:00\", label: \"Overlaps both time zones\" }, { id: \"14\", time: \"14:00\", label: \"After lunch in Frankfurt\" }, { id: \"15\", time: \"15:00\", label: \"Quiet hour on both calendars\" }, { id: \"16\", time: \"16:00\", label: \"Held for on-call handover\", taken: true }, { id: \"17\", time: \"17:00\", label: \"Last hour of the Frankfurt day\" }, ]"
      }
    ],
    "events": [
      {
        "name": "schedule",
        "type": "[slot: string]"
      }
    ],
    "slots": []
  },
  "examples": [
    {
      "id": "default",
      "title": "Default pattern",
      "description": "Use the default typed pattern as a production-ready starting point.",
      "source": "<script setup lang=\"ts\">\nimport SchedulePlannerCard from \"@/components/compositions/SchedulePlannerCard.vue\";\n</script>\n\n<template>\n  <SchedulePlannerCard title=\"Pattern placeholder\" />\n</template>"
    },
    {
      "id": "inherited-design",
      "title": "Inherited design",
      "description": "The same composition follows the nearest Balsa theme and palette without pinned presentation.",
      "source": "<script setup lang=\"ts\">\nimport SchedulePlannerCard from \"@/components/compositions/SchedulePlannerCard.vue\";\n</script>\n\n<template>\n  <SchedulePlannerCard title=\"Pattern placeholder\" />\n</template>"
    }
  ]
}
