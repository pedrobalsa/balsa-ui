{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://balsa-ui.com/schemas/catalog.json",
  "title": "Balsa agent catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseVersion", "framework", "generatedFrom", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "framework": { "const": "vue" },
    "generatedFrom": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "category", "classification", "description", "status", "version", "registry", "registryDependencies", "npmDependencies", "tokens", "documentation", "example", "source", "framework"],
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "category": { "enum": ["component", "composition", "block"] },
          "classification": { "enum": ["upstream-default", "balsa-addition", "balsa-composition", "balsa-alternative", "legacy", "retire"] },
          "upstream": { "type": "object", "additionalProperties": false, "required": ["registry", "name"], "properties": { "registry": { "type": "string" }, "name": { "type": "string" } } },
          "description": { "type": "string" },
          "status": { "enum": ["experimental", "beta", "stable", "deprecated"] },
          "version": { "type": "string" },
          "registry": { "type": "string", "pattern": "^@balsa/" },
          "registryDependencies": { "type": "array", "items": { "type": "string" } },
          "npmDependencies": { "type": "array", "items": { "type": "string" } },
          "tokens": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "documentation": { "type": "string" },
          "example": { "type": "string" },
          "source": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "framework": { "const": "vue" }
        }
      }
    }
  }
}
