            }
          ]
        },
        "required": false
      },
      {
        "name": "type",
        "type": "ColorPickerType | undefined",
        "values": [
          "field",
          "palette"
        ],
        "required": false,
        "default": "\"field\""
      },
      {
        "name": "labelPosition",
        "type": "ColorPickerLabelPosition | undefined",
        "values": [
          "inside",
