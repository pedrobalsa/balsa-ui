  "version": "0.1.0",
  "purpose": "Explore typed rows through sorting, quick field and advanced filters, pagination, selection, visibility, render slots, and independently configurable header and row colors.",
  "useFor": [
    "Interactive result sets",
    "Administrative lists",
    "Selectable records"
  ],
  "avoidFor": [
    "Static semantic tables",
    "Virtualized millions of rows",
    "Spreadsheet editing"
  ],
  "states": [
    "sorted",
    "filtered",
    "paginated",
    "selected",
    "loading",
    "empty"
  ],
  "accessibility": [
    "Composes semantic Table and Pagination.",
    "The bottom filter action opens a labelled dialog with a field Select and text search input.",
    "Selection inputs have row-specific names."
  ],
  "variants": [
    "surface",
    "outline",
    "soft",
    "glass"
  ],
  "sizes": [
    "compact",
    "default",
    "comfortable"
