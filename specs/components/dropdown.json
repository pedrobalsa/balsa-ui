{
  "schemaVersion": 1,
  "name": "dropdown",
  "title": "Dropdown",
  "category": "component",
  "classification": "balsa-addition",
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Render a compact anchored panel with configurable width and geometry for a small, consumer-defined group of links or actions.",
  "useFor": [
    "Compact navigation menus",
    "Contextual action groups",
    "Small anchored link collections"
  ],
  "avoidFor": [
    "Large mega menus",
    "Long unstructured inventories",
    "Modal confirmation flows"
  ],
  "variants": [
    "surface",
    "outline",
    "soft",
    "glass"
  ],
  "states": [
    "open",
    "closed",
    "automatic edge collision handling"
  ],
  "accessibility": [
    "Keeps its consumer-provided content in the document flow for keyboard navigation.",
    "Marks a closed panel aria-hidden and prevents pointer interaction.",
    "Consumers own trigger semantics, focus management, and any menu role appropriate to their content."
  ],
  "tokens": [
    "--balsa-color-background",
    "--balsa-color-foreground",
    "--balsa-color-surface-elevated",
    "--balsa-color-surface-elevated-foreground",
    "--balsa-color-primary",
    "--balsa-color-secondary",
    "--balsa-color-accent",
    "--balsa-color-destructive",
    "--balsa-color-muted",
    "--balsa-color-focus-ring",
    "radius.surface"
  ],
  "commonMistakes": [
    "Using Dropdown as a standalone trigger instead of placing it in a relative parent.",
    "Using a fixed start or end alignment when the trigger can approach the opposite viewport edge; use auto instead.",
    "Applying menu roles to normal navigation links.",
    "Filling a compact dropdown with an unstructured large inventory."
  ],
  "examples": [
    "Anchored link list",
    "Contextual action panel",
    "Compact Navbar submenu"
  ],
  "publicApi": {
    "source": "src/components/ui/Dropdown.vue",
    "props": [
      {
        "name": "open",
        "type": "boolean",
        "values": [
          "false",
          "true"
        ],
        "required": true
      },
      {
        "name": "variant",
        "type": "DropdownVariant | undefined",
        "values": [
          "soft",
          "outline",
          "glass",
          "surface"
        ],
        "required": false
      },
      {
        "name": "color",
        "type": "ActionColor | undefined",
        "values": [
          "primary",
          "neutral",
          "secondary",
          "accent",
          "destructive"
        ],
        "required": false,
        "default": "\"primary\""
      },
      {
        "name": "align",
        "type": "DropdownAlign | undefined",
        "values": [
          "end",
          "auto",
          "center",
          "start"
        ],
        "required": false,
        "default": "\"start\""
      },
      {
        "name": "width",
        "type": "DropdownWidth | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "xl"
        ],
        "required": false,
        "default": "\"md\""
      },
      {
        "name": "rounded",
        "type": "Rounded | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "xl",
          "2xl",
          "none",
          "3xl",
          "full"
        ],
        "required": false
      },
      {
        "name": "shadow",
        "type": "ThemeShadow | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "auto",
          "none"
        ],
        "required": false
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      }
    ],
    "events": [],
    "slots": [
      {
        "name": "default",
        "type": "{}"
      }
    ]
  }
}
