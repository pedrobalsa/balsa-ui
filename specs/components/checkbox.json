{
  "schemaVersion": 1,
  "name": "checkbox",
  "title": "Checkbox",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "checkbox"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Capture an explicit independent yes-or-no selection in a form.",
  "useFor": [
    "Terms acceptance",
    "Independent multi-option selection",
    "Explicit confirmation"
  ],
  "avoidFor": [
    "Immediate settings changes",
    "Mutually exclusive choices",
    "Action triggers"
  ],
  "variants": [
    "outline",
    "surface",
    "soft",
    "glass"
  ],
  "states": [
    "checked",
    "unchecked",
    "disabled",
    "unvalidated"
  ],
  "accessibility": [
    "Uses a native checkbox with an associated visible label.",
    "Hint text is linked with aria-describedby.",
    "Required and disabled states retain native semantics and visible styling."
  ],
  "tokens": [
    "--balsa-color-input",
    "--balsa-color-input-border",
    "--balsa-color-primary",
    "--balsa-color-primary-foreground",
    "--balsa-color-focus-ring",
    "--balsa-color-disabled",
    "radius.control"
  ],
  "commonMistakes": [
    "Using Checkbox for a button action.",
    "Omitting a stable id and visible label.",
    "Using several checkboxes for mutually exclusive choices."
  ],
  "examples": [
    "Agreement checkbox",
    "Checked option",
    "Required unvalidated checkbox"
  ],
  "publicApi": {
    "source": "src/components/ui/Checkbox.vue",
    "models": [
      {
        "name": "modelValue",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "event": "update:modelValue"
      }
    ],
    "props": [
      {
        "name": "id",
        "type": "string",
        "required": true
      },
      {
        "name": "label",
        "type": "string",
        "required": true
      },
      {
        "name": "hint",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false
      },
      {
        "name": "disabled",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "required",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "size",
        "type": "CheckboxSize | undefined",
        "values": [
          "md",
          "sm",
          "lg"
        ],
        "required": false
      },
      {
        "name": "variant",
        "type": "FieldVariant | undefined",
        "values": [
          "soft",
          "outline",
          "glass",
          "surface"
        ],
        "required": false
      },
      {
        "name": "rounded",
        "type": "Rounded | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "xl",
          "2xl",
          "none",
          "3xl",
          "full"
        ],
        "required": false
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      },
      {
        "name": "modelValue",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      }
    ],
    "events": [
      {
        "name": "update:modelValue",
        "type": "[value: boolean]"
      }
    ],
    "slots": []
  }
}
