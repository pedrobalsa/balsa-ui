{
  "schemaVersion": 1,
  "name": "popup",
  "title": "Popup",
  "category": "component",
  "classification": "balsa-alternative",
  "upstream": {
    "registry": "@shadcn",
    "name": "popover"
  },
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Show interactive rich content in a collision-aware surface anchored to a button.",
  "useFor": [
    "Compact forms",
    "Contextual settings",
    "Rich interactive details"
  ],
  "avoidFor": [
    "Action menus",
    "Hover-only previews",
    "Blocking decisions"
  ],
  "types": [
    "top",
    "right",
    "bottom",
    "left"
  ],
  "states": [
    "closed",
    "open",
    "disabled"
  ],
  "sizes": [
    "sm",
    "md",
    "lg",
    "trigger"
  ],
  "accessibility": [
    "The native trigger exposes expanded, controls, and dialog popup semantics.",
    "Opening may move focus into content; Escape and outside dismissal restore the trigger.",
    "Teleported content retains the source theme and palette."
  ],
  "tokens": [
    "--balsa-color-surface-elevated",
    "--balsa-color-border-strong",
    "--balsa-color-focus-ring",
    "radius.control",
    "shadow.panel"
  ],
  "commonMistakes": [
    "Using Popup for a menu.",
    "Omitting an accessible popup label.",
    "Putting blocking confirmation in a non-modal popup."
  ],
  "examples": [
    "Settings form",
    "Aligned details",
    "Trigger-width content",
    "Contained preview"
  ],
  "publicApi": {
    "source": "src/components/ui/Popup.vue",
    "models": [
      {
        "name": "modelValue",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "event": "update:modelValue"
      }
    ],
    "props": [
      {
        "name": "id",
        "type": "string",
        "required": true
      },
      {
        "name": "label",
        "type": "string",
        "required": true
      },
      {
        "name": "side",
        "type": "AnchoredSide | undefined",
        "values": [
          "bottom",
          "top",
          "right",
          "left"
        ],
        "required": false,
        "default": "\"bottom\""
      },
      {
        "name": "align",
        "type": "AnchoredAlign | undefined",
        "values": [
          "end",
          "center",
          "start"
        ],
        "required": false,
        "default": "\"center\""
      },
      {
        "name": "sideOffset",
        "type": "number | undefined",
        "values": [
          "number"
        ],
        "required": false,
        "default": "8"
      },
      {
        "name": "alignOffset",
        "type": "number | undefined",
        "values": [
          "number"
        ],
        "required": false,
        "default": "0"
      },
      {
        "name": "variant",
        "type": "LayerVariant | undefined",
        "values": [
          "soft",
          "outline",
          "glass",
          "surface"
        ],
        "required": false
      },
      {
        "name": "size",
        "type": "PopupSize | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "trigger"
        ],
        "required": false
      },
      {
        "name": "rounded",
        "type": "Rounded | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "xl",
          "2xl",
          "none",
          "3xl",
          "full"
        ],
        "required": false
      },
      {
        "name": "shadow",
        "type": "ThemeShadow | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "auto",
          "none"
        ],
        "required": false
      },
      {
        "name": "contained",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "disabled",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "initialFocus",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "true"
      },
      {
        "name": "dismissOnOutside",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "true"
      },
      {
        "name": "triggerAriaLabelledby",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false
      },
      {
        "name": "triggerAriaDescribedby",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false
      },
      {
        "name": "triggerAriaInvalid",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false
      },
      {
        "name": "triggerAriaRequired",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      },
      {
        "name": "modelValue",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      }
    ],
    "events": [
      {
        "name": "update:modelValue",
        "type": "[value: boolean]"
      }
    ],
    "slots": [
      {
        "name": "trigger",
        "type": "{}"
      },
      {
        "name": "default",
        "type": "{ close: (restoreFocus?: boolean) => void; }"
      }
    ]
  }
}
