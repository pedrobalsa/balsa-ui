{
  "schemaVersion": 1,
  "name": "code-block",
  "title": "Code block",
  "category": "component",
  "classification": "balsa-addition",
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Present source code or commands with accessible compact text actions and icon-only copy.",
  "useFor": [
    "Installation commands",
    "Short source examples",
    "Configuration snippets"
  ],
  "avoidFor": [
    "Editable code input",
    "Rich syntax-editor workflows",
    "Prose quotations"
  ],
  "states": [
    "idle",
    "copied",
    "wrapped",
    "scrollable",
    "numbered",
    "highlighted",
    "collapsed",
    "expanded",
    "inline single-line command"
  ],
  "accessibility": [
    "Uses preformatted code semantics.",
    "Syntax color supplements rather than replaces the source text.",
    "Optional line numbers are hidden from assistive technology and excluded from copied source.",
    "Collapsed previews retain the complete source in the document and expose keyboard-accessible See more and Show less actions.",
    "The copy result is announced through a polite live region.",
    "The icon-only copy control has a stable accessible name.",
    "Header actions retain their own accessible group names.",
    "The Glassmorphism material remains dark, gives labels and outline header actions an explicit code-surface contrast context, and restores an opaque code surface for increased contrast or reduced transparency."
  ],
  "tokens": [
    "--balsa-color-code",
    "--balsa-color-code-foreground",
    "radius.control"
  ],
  "commonMistakes": [
    "Using it as an editable editor.",
    "Putting unexplained secrets in examples.",
    "Forcing wrapping for long commands that must remain exact.",
    "Making the Glassmorphism surface so transparent that it no longer reads as a consistently dark code surface."
  ],
  "examples": [
    "Install command with package-manager actions",
    "Highlighted Vue source example",
    "Wrapped configuration"
  ],
  "publicApi": {
    "source": "src/components/ui/CodeBlock.vue",
    "props": [
      {
        "name": "code",
        "type": "string",
        "required": true
      },
      {
        "name": "language",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"text\""
      },
      {
        "name": "label",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false
      },
      {
        "name": "layout",
        "type": "CodeBlockLayout | undefined",
        "values": [
          "inline",
          "block"
        ],
        "required": false,
        "default": "\"block\""
      },
      {
        "name": "copyable",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "true"
      },
      {
        "name": "wrap",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "lineNumbers",
        "type": "boolean | undefined",
        "values": [
          "false",
          "true"
        ],
        "required": false,
        "default": "false"
      },
      {
        "name": "collapsedLines",
        "type": "number | undefined",
        "values": [
          "number"
        ],
        "required": false
      },
      {
        "name": "size",
        "type": "CodeBlockSize | undefined",
        "values": [
          "md",
          "sm",
          "lg"
        ],
        "required": false
      },
      {
        "name": "rounded",
        "type": "Rounded | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "xl",
          "2xl",
          "none",
          "3xl",
          "full"
        ],
        "required": false
      },
      {
        "name": "shadow",
        "type": "ThemeShadow | undefined",
        "values": [
          "md",
          "sm",
          "lg",
          "auto",
          "none"
        ],
        "required": false
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      }
    ],
    "events": [],
    "slots": [
      {
        "name": "actions",
        "type": "{}"
      }
    ]
  }
}
