{
  "schemaVersion": 1,
  "name": "footer",
  "title": "Footer",
  "category": "component",
  "classification": "balsa-addition",
  "status": "beta",
  "version": "0.1.0",
  "purpose": "Close an application with brand context, grouped links, and optional contact or social information.",
  "useFor": [
    "Application shells",
    "Documentation sites",
    "Grouped secondary navigation"
  ],
  "avoidFor": [
    "Primary task actions",
    "Unconfirmed contact information",
    "A second primary navigation experience"
  ],
  "states": [
    "links only",
    "with contacts",
    "with social links",
    "variable navigation sections"
  ],
  "accessibility": [
    "Uses a semantic footer and labeled navigation landmark with native links.",
    "External social links receive accessible names and noreferrer protection.",
    "The linked brand image or text title requires a meaningful accessible name."
  ],
  "tokens": [
    "--balsa-color-inverse",
    "--balsa-color-inverse-foreground",
    "--balsa-color-border-strong"
  ],
  "commonMistakes": [
    "Hard-coding application data inside Footer.",
    "Assuming the navigation always has exactly three sections.",
    "Publishing placeholder contact information as real data.",
    "Using decorative icon-only links without accessible names."
  ],
  "examples": [
    "Documentation footer",
    "Footer with editable navigation sections",
    "Footer with contacts and social links"
  ],
  "publicApi": {
    "source": "src/components/ui/Footer.vue",
    "props": [
      {
        "name": "legalLogo",
        "type": "BrandLogo",
        "shape": {
          "type": "BrandLogo",
          "variants": [
            {
              "type": "BrandImage",
              "fields": [
                {
                  "name": "src",
                  "type": "string",
                  "required": true
                },
                {
                  "name": "alt",
                  "type": "string",
                  "required": true
                },
                {
                  "name": "href",
                  "type": "string",
                  "required": true
                },
                {
                  "name": "title",
                  "type": "undefined",
                  "required": false
                }
              ]
            },
            {
              "type": "BrandTitle",
              "fields": [
                {
                  "name": "title",
                  "type": "string",
                  "required": true
                },
                {
                  "name": "alt",
                  "type": "string",
                  "required": true
                },
                {
                  "name": "href",
                  "type": "string",
                  "required": true
                },
                {
                  "name": "src",
                  "type": "undefined",
                  "required": false
                }
              ]
            }
          ]
        },
        "required": true
      },
      {
        "name": "description",
        "type": "string",
        "required": true
      },
      {
        "name": "sections",
        "type": "readonly FooterSection[]",
        "required": true
      },
      {
        "name": "copyright",
        "type": "string",
        "required": true
      },
      {
        "name": "contactGroups",
        "type": "readonly FooterContactGroup[] | undefined",
        "required": false,
        "default": "[]"
      },
      {
        "name": "socialLinks",
        "type": "readonly FooterSocialLink[] | undefined",
        "required": false,
        "default": "[]"
      },
      {
        "name": "leadTitle",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Balsa UI\""
      },
      {
        "name": "navigationLabel",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Footer navigation\""
      },
      {
        "name": "legalText",
        "type": "string | undefined",
        "values": [
          "string"
        ],
        "required": false,
        "default": "\"Open source. Open code. Built for Vue.\""
      },
      {
        "name": "theme",
        "type": "ThemeInput | undefined",
        "shape": {
          "type": "ThemeDefinition",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "name",
              "type": "string",
              "required": true
            },
            {
              "name": "extends",
              "type": "\"modern-flat\" | \"brutalism\" | \"glassmorphism\" | ThemeDefinition",
              "required": true
            },
            {
              "name": "options",
              "type": "ThemeOptions | undefined",
              "required": false
            },
            {
              "name": "overrides",
              "type": "ThemeOverrides | undefined",
              "required": false
            },
            {
              "name": "tokens",
              "type": "ThemeTokens | undefined",
              "required": false
            },
            {
              "name": "defaults",
              "type": "ThemeDefaults | undefined",
              "required": false
            }
          ]
        },
        "required": false
      }
    ],
    "events": [],
    "slots": []
  }
}
