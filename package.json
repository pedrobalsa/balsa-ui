{
  "name": "balsa-ui",
  "version": "0.2.0",
  "description": "Agent-native, open-code Vue 3 components with independent palettes, themes, and gradient backgrounds.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://balsa-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrobalsa/balsa-ui.git"
  },
  "bugs": {
    "url": "https://github.com/pedrobalsa/balsa-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "design-system",
    "tailwindcss",
    "ai",
    "agents",
    "shadcn"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "balsa": "bin/balsa.mjs"
  },
  "files": [
    ".balsa/catalog.json",
    ".balsa/catalog-index.json",
    "LICENSE",
    "README.md",
    "bin",
    "docs/components",
    "docs/compositions",
    "scripts/agent-context.mjs",
    "scripts/background-cli.mjs",
    "scripts/theme-cli.mjs",
    "scripts/design-system-cli.mjs",
    "scripts/palette-cli.mjs",
    "scripts/install-registry.mjs",
    "scripts/registry-lib.mjs",
    "registry.json",
    "skills/balsa-ui",
    "specs/components",
    "src/background/background-studio.ts",
    "src/components/ui",
    "src/components/compositions",
    "src/styles",
    "src/theme"
  ],
  "scripts": {
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "catalog:build": "node scripts/build-catalog.mjs",
    "agent-docs:build": "node scripts/build-agent-docs.mjs",
    "registry:build": "node scripts/build-registry.mjs && node scripts/build-agent-docs.mjs",
    "registry:validate": "node scripts/validate-registry.mjs",
    "registry:list": "node scripts/list-registry.mjs",
    "registry:install": "node scripts/install-registry.mjs",
    "test:registry": "node scripts/smoke-registry.mjs",
    "starter:sync": "node scripts/sync-starter.mjs",
    "starter:check": "npm --prefix starters/vue run check",
    "fixtures:install": "npm --prefix starters/vue ci --ignore-scripts --no-audit --no-fund && npm --prefix tests/fixtures/registry-vue ci --ignore-scripts --no-audit --no-fund",
    "build": "npm run registry:build && npm run typecheck",
    "check:changed": "node scripts/check-changed.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run registry:validate && npm run test:registry && npm run starter:sync && npm run starter:check",
    "cli": "node bin/balsa.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "@lucide/vue": "^1.28.0",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "highlight.js": "^11.11.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "vue": "^3.5.34",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "ajv": "^8.17.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.52.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.8"
  }
}
