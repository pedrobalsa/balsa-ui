{
  "name": "balsa-ui",
  "version": "0.8.0",
  "description": "Agent-native, open-code Vue 3 components with independent palettes, themes, and gradient backgrounds.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://balsa-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrobalsa/balsa-ui.git"
  },
  "bugs": {
    "url": "https://github.com/pedrobalsa/balsa-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "design-system",
    "tailwindcss",
    "ai",
    "agents",
    "shadcn"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "balsa": "bin/balsa.mjs"
  },
  "files": [
    ".balsa/catalog.json",
    ".balsa/catalog-index.json",
    "LICENSE",
    "README.md",
    "bin",
    "docs/components",
    "docs/compositions",
    "scripts/agent-context.mjs",
    "scripts/background-cli.mjs",
    "scripts/text-3d-cli.mjs",
    "scripts/theme-cli.mjs",
    "scripts/design-system-cli.mjs",
    "scripts/palette-cli.mjs",
    "scripts/package-manager.mjs",
    "scripts/install-registry.mjs",
    "scripts/project-diagnostics.mjs",
    "scripts/project-framework.mjs",
    "scripts/catalog.mjs",
    "scripts/registry-lib.mjs",
    "scripts/registry-resolve.mjs",
    "scripts/apply-adapters.mjs",
    "scripts/theme-bridge.mjs",
    "scripts/source-imports.mjs",
    "scripts/diff-installed.mjs",
    "scripts/mcp-server.mjs",
    "adapters",
    "public/fonts/typeface",
    "registry.json",
    "packages/shared/registry.json",
    "packages/shared/src",
    "packages/react/registry.json",
    "packages/react",
    "skills/balsa-ui",
    "skills/balsa-template-design",
    "specs/components",
    "src/agent/studio-workflows.ts",
    "src/framework/copy.ts",
    "src/config/public-site.ts",
    "src/background/gradient-studio.ts",
    "src/components/ui",
    "src/components/compositions",
    "src/config/components-template.json",
    "src/config/components-template-react.json",
    "src/design-system/built-ins.json",
    "src/styles",
    "src/theme-core",
    "src/portal-core",
    "src/theme"
  ],
  "scripts": {
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "catalog:build": "node scripts/build-catalog.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:validate": "node scripts/validate-registry.mjs",
    "registry:typecheck": "node scripts/check-strict-consumer.mjs",
    "registry:list": "node scripts/list-registry.mjs",
    "registry:install": "node scripts/install-registry.mjs",
    "contracts:build": "node scripts/build-contracts.mjs",
    "contracts:check": "node scripts/build-contracts.mjs --check",
    "examples:build": "node scripts/build-examples.mjs",
    "examples:check": "node scripts/build-examples.mjs --check --typecheck",
    "adapters:build": "node scripts/build-adapters.mjs",
    "package:check": "node scripts/check-package-runtime.mjs",
    "release:check": "node scripts/check-release-consistency.mjs",
    "test:registry": "node scripts/smoke-registry.mjs",
    "starter:sync": "node scripts/sync-starter.mjs",
    "starter:check": "npm --prefix starters/vue run check",
    "fixtures:install": "npm --prefix starters/vue ci --ignore-scripts --no-audit --no-fund && npm --prefix starters/react ci --ignore-scripts --no-audit --no-fund && npm --prefix tests/fixtures/registry-vue ci --ignore-scripts --no-audit --no-fund",
    "build": "npm run registry:build && npm run typecheck",
    "check:changed": "node scripts/check-changed.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run registry:validate && npm run contracts:check && npm run examples:check && npm run registry:typecheck && npm run test:registry && npm run starter:sync && npm run starter:check && npm run package:check && npm run release:check",
    "cli": "node bin/balsa.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/rubik-spray-paint": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "@lucide/vue": "^1.28.0",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "vue": "^3.5.34",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.1",
    "@unovis/react": "^1.6.7",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "ajv": "^8.17.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "fontkit": "^2.0.4",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "lucide-react": "^1.31.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.52.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.18",
    "vue-component-meta": "^3.3.9",
    "vue-tsc": "^3.2.8"
  }
}
