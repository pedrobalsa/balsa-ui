{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/background/**/*.ts",
    "src/components/ui/**/*.ts",
    "src/components/ui/**/*.vue",
    "src/theme/**/*.ts"
  ]
}
